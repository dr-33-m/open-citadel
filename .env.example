# Local dev config for the app. Copy to `.env`, which is gitignored.
#
# Expo loads `.env` before evaluating `app.config.js`, so these arrive as
# `extra` on the built config (see `constants/samwell-cloud` and
# `constants/logto`). EAS builds do NOT read this file -- set the same names as
# EAS environment variables on the matching profile instead.
#
# None of these are secrets: they all ship inside the APK, and a native OIDC
# app is a public client with no secret to keep. They are kept out of git
# because this repo is public and they name self-hosted infrastructure, which
# is worth not advertising.

# Where Samwell Cloud lives. Empty means the build has no cloud Samwell.
SAMWELL_CLOUD_URL=

# The Logto tenant, and the Native application inside it. Empty means the
# build has no accounts at all: no account card, and cloud Samwell reports
# himself unavailable rather than asking anyone to sign in.
LOGTO_ENDPOINT=
LOGTO_APP_ID=

# RevenueCat, for the subscription. Public SDK keys, not secrets: they ship
# inside the binary either way, and a native app has no secret to keep.
#
# REVENUECAT_TEST_KEY points at RevenueCat's Test Store, which serves real
# offerings and real purchase flows with NO App Store Connect or Play Console
# setup at all. It wins over the platform keys when set, so a development
# build can exercise buying a plan long before the stores are ready. Leave it
# empty in a production build.
#
# Empty everywhere means the build has no plans to sell: cloud Samwell says so
# plainly instead of drawing a carousel nobody can buy from.
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
REVENUECAT_TEST_KEY=
