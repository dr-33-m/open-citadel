OPENROUTER_API_KEY=sk-or-...
PORT=8787
DATABASE_URL=file:./samwell-cloud.sqlite
SAMWELL_ALLOWED_ORIGIN=*
OPENROUTER_HTTP_REFERER=https://opencitadel.app
OPENROUTER_APP_TITLE=Open Citadel
# Required to call POST /admin/models (send it as the x-admin-key header)
ADMIN_API_KEY=

# Logto, for verifying the account behind every metered request. Same tenant
# endpoint the app is built with. Without it, every metered route answers 500.
LOGTO_ENDPOINT=https://your-tenant.logto.app

# Logto again, this time as a caller rather than a verifier: DELETE /account
# deletes the Logto user, and only a machine-to-machine application may do
# that. Create one in the Logto console, give it the Logto Management API role,
# and paste its id and secret here. Without both, account deletion answers 500
# and `/health` reports `deletionReady: false` - and App Store guideline
# 5.1.1(v) requires the app to be able to delete an account.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# Only for a self-hosted tenant behind a custom domain, whose management API
# still calls itself https://default.logto.app/api. On Logto Cloud leave this
# empty and LOGTO_ENDPOINT answers for it.
LOGTO_MANAGEMENT_RESOURCE=

# The Gutendex instance the free-books search reads from. Gutendex is the JSON
# API over Project Gutenberg's catalogue; this points at a self-hosted one so
# onboarding and the free-books library are not built on someone else's rate
# limit. Left empty the server falls back to the public https://gutendex.com.
#
# Out of git for the same reason SAMWELL_CLOUD_URL is: it names self-hosted
# infrastructure and this repo is public.
GUTENDEX_URL=

# Which model serves the free onboarding conversation. The house pays for this
# one, so the client never chooses it. Falls back to the default cloud model,
# and `server_settings.onboarding_model_id` overrides this without a deploy.
ONBOARDING_MODEL_ID=
