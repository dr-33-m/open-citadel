# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Uniwind (regenerated from metro.config.js's extraThemes on every build)
uniwind-types.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
!server/.env.example

# local databases / generated server output
*.sqlite
*.sqlite-*
server/dist/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# tarballs and builds
*.tgz
build-*.apk
# Agent skills: the ones from skills.sh are restored from skills-lock.json. Only
# our own have no source to restore from, so only those are kept here.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/open-citadel-*
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/open-citadel-*/
.vscode/
# Local build artifacts. `eas build --local` drops these in the repo root.
build-*.tar.gz
# Local store builds (eas build --local --output). Also keeps them out of the
# next local build's project archive, which is packed from this folder.
*.ipa
*.aab
*.apk

# Local Expo modules: Gradle output
modules/*/android/build/

# Cloud voice samples made by a local server (production keeps them on /data)
voice-samples/
listening-test/
