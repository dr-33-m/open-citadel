+  const entry = {
+    key,
+    runtime,
+    made
+  };
+  sharedPhonemizers.push(entry);
+  // A failed creation is not kept, so the next pipeline tries again.
+  made.catch(() => {
+    const index = sharedPhonemizers.indexOf(entry);
+    if (index >= 0) sharedPhonemizers.splice(index, 1);
+  });
+  return made;
+}
