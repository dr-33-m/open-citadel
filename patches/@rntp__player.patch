index 0000000000000000000000000000000000000000..5a150624c95f8ff4f2d2cfb8bc2ff070e51b903f
--- /dev/null
+++ b/android/src/main/java/com/doublesymmetry/trackplayer/models/ChapterClock.kt
@@ -0,0 +1,31 @@
+/*
+ * PATCHED (Open Citadel): the chapter clock for a book heard a sentence at a time.
+ */
+
+package com.doublesymmetry.trackplayer.models
+
+import androidx.media3.common.MediaItem
+
+/**
+ * A book plays one sentence per item, so the item's own clock is a few
+ * seconds long. The app puts where the sentence starts in its chapter and how
+ * long the chapter is into the item's extras (`chapterStart`,
+ * `chapterLength`, seconds), and the notification and the lock screen show
+ * the chapter's clock from them, the way an audiobook app does. Items
+ * without them (episodes) keep their own clock.
+ */
+data class ChapterClock(val startMs: Long, val lengthMs: Long) {
+  companion object {
+    fun of(item: MediaItem?): ChapterClock? {
+      val extras = item?.mediaMetadata?.extras?.getBundle(MediaItemExtras.METADATA_KEY) ?: return null
+      if (!extras.containsKey("chapterStart") || !extras.containsKey("chapterLength")) return null
+      val start = extras.getDouble("chapterStart", -1.0)
+      val length = extras.getDouble("chapterLength", -1.0)
+      if (start < 0 || length <= 0) return null
+      return ChapterClock((start * 1000).toLong(), (length * 1000).toLong())
+    }
+
+    /** Whether an item is a sentence of a book: what the Highlight button is offered for. */
+    fun isBook(item: MediaItem?): Boolean = of(item) != null
+  }
+}
