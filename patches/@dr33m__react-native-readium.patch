+++ b/ios/Reader/TTS/KokoroTTSEngine.swift
@@ -0,0 +1,276 @@
+import AVFoundation
+import Foundation
+import ReadiumNavigator
+import ReadiumShared
+
+/// `TTSEngine` that hands each utterance to JS for synthesis — Kokoro's model
+/// runs in `react-native-executorch`'s JS layer, not natively — and plays the
+/// returned PCM back itself via `AVAudioEngine`.
+///
+/// Voice and language selection flow through Readium's own
+/// `PublicationSpeechSynthesizer.Configuration.voiceIdentifier`/`defaultLanguage`
+/// exactly as they do for `AVTTSEngine` — it resolves the `TTSVoice` for us via
+/// `voiceWithIdentifier` and builds `TTSUtterance.voiceOrLanguage` from it. Only
+/// speed has no equivalent on `TTSUtterance`, so `TTSManager` sets it directly.
+@MainActor
+final class KokoroTTSEngine: NSObject, TTSEngine {
+    static let voices: [TTSVoice] = [
+        TTSVoice(identifier: "af_heart", language: Language(code: .bcp47("en-US")), name: "Heart", gender: .female, quality: nil),
+        TTSVoice(identifier: "af_river", language: Language(code: .bcp47("en-US")), name: "River", gender: .female, quality: nil),
+        TTSVoice(identifier: "af_sarah", language: Language(code: .bcp47("en-US")), name: "Sarah", gender: .female, quality: nil),
+        TTSVoice(identifier: "am_adam", language: Language(code: .bcp47("en-US")), name: "Adam", gender: .male, quality: nil),
+        TTSVoice(identifier: "am_michael", language: Language(code: .bcp47("en-US")), name: "Michael", gender: .male, quality: nil),
+        TTSVoice(identifier: "am_santa", language: Language(code: .bcp47("en-US")), name: "Santa", gender: .male, quality: nil),
+        TTSVoice(identifier: "bf_emma", language: Language(code: .bcp47("en-GB")), name: "Emma", gender: .female, quality: nil),
+        TTSVoice(identifier: "bm_daniel", language: Language(code: .bcp47("en-GB")), name: "Daniel", gender: .male, quality: nil),
+    ]
+
+    var availableVoices: [TTSVoice] { Self.voices }
+
+    func voiceWithIdentifier(_ identifier: String) -> TTSVoice? {
+        Self.voices.first { $0.identifier == identifier }
+    }
+
+    /// Speed for the next `speak` call. Set by `TTSManager` — see the type note above.
+    var speed: Double = 1.0
+
+    var onSynthesisRequest: ((TTSSynthesisRequest) -> Void)?
+    var onSynthesisCancel: ((String) -> Void)?
+
+    /// A page turn `HybridReadiumView` already dispatched for the utterance
+    /// about to be spoken. Kokoro's audio starts as soon as
+    /// `onSynthesisRequest` fires, so without waiting for this first, a
+    /// short/fast utterance could become audible before the page it's on has
+    /// actually turned into view — the reader would visibly still show the
+    /// old page while a new sentence starts. Set right before `speak()` is
+    /// called for the matching utterance (see `TTSManager.setPendingNavigation`);
+    /// consumed and cleared at most once per call.
+    ///
+    /// `Swift.Task`, not the bare name: the nested `Task` class below shadows
+    /// it for the rest of this file.
+    var pendingNavigation: Swift.Task<Void, Never>?
+
+    // Named `Task` to match `AVTTSEngine`'s own nested-type convention in this
+    // SDK; it shadows `Swift.Task` within this file, which is safe here since
+    // nothing below spawns one.
+    private final class Task {
+        let requestId = UUID().uuidString
+        var continuation: CheckedContinuation<Result<Void, TTSError>, Never>?
+        var isCancelled = false
+        /// Set once the last chunk has been scheduled; playback completion then finishes the task.
+        var isLastScheduled = false
+        var scheduledBuffers = 0
+        var completedBuffers = 0
+    }
+
+    private var tasks: [String: Task] = [:]
+    /// The MP3 decoder for the utterance answering in encoded audio, if any.
+    private var decoder: Mp3StreamDecoder?
+    private var decoderRequestId: String?
+    private let audioEngine = AVAudioEngine()
+    private let playerNode = AVAudioPlayerNode()
+    private var connectedSampleRate: Double?
+
+    override init() {
+        super.init()
+        audioEngine.attach(playerNode)
+    }
+
+    private func ensureEngineRunning(sampleRate: Double) throws {
+        if connectedSampleRate != sampleRate {
+            playerNode.stop()
+            audioEngine.disconnectNodeOutput(playerNode)
+            guard let format = AVAudioFormat(standardFormatWithSampleRate: sampleRate, channels: 1) else {
+                throw TTSError.other(NSError(domain: "KokoroTTSEngine", code: -1, userInfo: [
+                    NSLocalizedDescriptionKey: "Unsupported sample rate \(sampleRate).",
+                ]))
+            }
+            audioEngine.connect(playerNode, to: audioEngine.mainMixerNode, format: format)
+            connectedSampleRate = sampleRate
+        }
+        if !audioEngine.isRunning {
+            try audioEngine.start()
+        }
+        if !playerNode.isPlaying {
+            playerNode.play()
+        }
+    }
+
+    func speak(
+        _ utterance: TTSUtterance,
+        onSpeakRange: @escaping (Range<String.Index>) -> Void
+    ) async -> Result<Void, TTSError> {
+        let task = Task()
+        tasks[task.requestId] = task
+
+        let voiceId: String?
+        let language: String?
+        switch utterance.voiceOrLanguage {
+        case let .left(voice):
+            voiceId = voice.identifier
+            language = voice.language.code.bcp47
+        case let .right(lang):
+            voiceId = nil
+            language = lang.code.bcp47
+        }
