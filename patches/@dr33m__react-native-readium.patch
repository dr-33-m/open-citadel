+        return await withTaskCancellationHandler {
+            if let navigation = pendingNavigation {
+                pendingNavigation = nil
+                await navigation.value
+            }
+            guard !task.isCancelled else { return .success(()) }
+
+            return await withCheckedContinuation { (continuation: CheckedContinuation<Result<Void, TTSError>, Never>) in
+                task.continuation = continuation
+                onSynthesisRequest?(TTSSynthesisRequest(
+                    requestId: task.requestId,
+                    text: utterance.text,
+                    language: language,
+                    voice: voiceId,
+                    speed: speed
+                ))
+            }
+        } onCancel: { [weak self] in
+            // Readium cancels a `speak` call from its own main-actor-isolated
+            // methods (`stop`/`next`/`previous`), the same invariant
+            // `AVTTSEngine`'s state machine relies on — no thread hop needed.
+            MainActor.assumeIsolated {
+                self?.cancelTask(requestId: task.requestId)
+            }
+        }
+    }
+
+    /// Answers a chunk of synthesized PCM for `requestId`. `samples` is raw
+    /// little-endian Float32 mono PCM, matching what `Float32Array.buffer`
+    /// produces on the JS side.
+    func provideAudioChunk(requestId: String, samples: Data, sampleRate: Double, isLast: Bool) {
+        guard let task = tasks[requestId], !task.isCancelled else { return }
+        do {
+            try ensureEngineRunning(sampleRate: sampleRate)
+        } catch let error as TTSError {
+            finishTask(requestId: requestId, result: .failure(error))
+            return
+        } catch {
+            finishTask(requestId: requestId, result: .failure(.other(error)))
+            return
+        }
+
+        let frameCount = samples.count / MemoryLayout<Float>.size
+        guard
+            frameCount > 0,
+            let format = AVAudioFormat(standardFormatWithSampleRate: sampleRate, channels: 1),
+            let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(frameCount))
+        else {
+            if isLast { finishScheduling(requestId: requestId) }
+            return
+        }
+        buffer.frameLength = AVAudioFrameCount(frameCount)
+        samples.withUnsafeBytes { raw in
+            guard let src = raw.bindMemory(to: Float.self).baseAddress, let dst = buffer.floatChannelData?[0] else { return }
+            dst.update(from: src, count: frameCount)
+        }
