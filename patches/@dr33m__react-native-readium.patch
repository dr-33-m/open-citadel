+  language?: string;
+  voice?: string;
+  speed?: number;
+}
+
+/**
+ * What Readium will read next, sent each time an utterance starts.
+ *
+ * Readium only asks for an utterance when it is due, so a voice whose audio
+ * is made elsewhere (a cloud voice, or an on-device model slower than the
+ * reading) would leave a gap before every one. These are the next utterances
+ * exactly as Readium will ask for them, from its own content iterator and
+ * sentence tokenizer, across paragraphs and resources, so their audio can be
+ * started early. `current` is the utterance they follow, to align against.
+ */
+export interface TTSUpcomingEvent {
+  current: string;
+  upcoming: string[];
+}
