new file mode 100644
index 0000000000000000000000000000000000000000..6f3e54f08056f65d828287a87a5edc25d5f641bf
--- /dev/null
+++ b/ios/Reader/TTS/Mp3StreamDecoder.swift
@@ -0,0 +1,185 @@
+import AVFoundation
+import AudioToolbox
+import Foundation
+
+/// One utterance of MP3, decoded to mono Float32 as it streams in.
+///
+/// A cloud voice can answer in MP3, about a tenth of the size of raw PCM. JS
+/// cannot decode it at any useful speed, so it hands the bytes over as they
+/// arrive: `AudioFileStream` finds the packets in them (whatever the chunk
+/// boundaries, and reading the encoder's priming from a LAME tag), and
+/// `AVAudioConverter` turns each run of packets into Float32 at the stream's
+/// own rate, so the first words play while the rest is still coming.
+///
+/// Driven from the main actor by `KokoroTTSEngine`, one utterance at a time.
+final class Mp3StreamDecoder {
+    static let mimeType = "audio/mpeg"
+
+    /// Decoded audio, mono Float32, at the stream's own sample rate.
+    private let onPCM: (_ samples: [Float], _ sampleRate: Double) -> Void
+
+    private var stream: AudioFileStreamID?
+    private var inputFormat: AVAudioFormat?
+    private var outputFormat: AVAudioFormat?
+    private var converter: AVAudioConverter?
+    private var maxPacketSize: UInt32 = 0
+    /// Frames of encoder delay still to cut from the start of the output.
+    private var toTrim: Int = 0
+    private(set) var sampleRate: Double = 0
+    private(set) var failure: OSStatus = noErr
+
+    init(onPCM: @escaping (_ samples: [Float], _ sampleRate: Double) -> Void) {
+        self.onPCM = onPCM
+        let context = Unmanaged.passUnretained(self).toOpaque()
+        // Closures rather than named functions so their parameter types are
+        // taken from the SDK's own callback types, whose optionality has
+        // moved between SDK versions. They capture nothing: the decoder comes
+        // back through the client-data pointer.
+        failure = AudioFileStreamOpen(
+            context,
+            { clientData, _, property, _ in
+                Unmanaged<Mp3StreamDecoder>.fromOpaque(clientData).takeUnretainedValue().propertyChanged(property)
+            },
+            { clientData, bytes, packets, data, descriptions in
+                Unmanaged<Mp3StreamDecoder>.fromOpaque(clientData).takeUnretainedValue()
+                    .packetsArrived(bytes: bytes, packets: packets, data: data, descriptions: descriptions)
+            },
+            kAudioFileMP3Type,
+            &stream
+        )
+    }
+
+    deinit {
+        if let stream { AudioFileStreamClose(stream) }
+    }
+
+    func feed(_ data: Data) {
+        guard let stream, failure == noErr, !data.isEmpty else { return }
+        let status = data.withUnsafeBytes { raw -> OSStatus in
+            guard let base = raw.baseAddress else { return noErr }
+            return AudioFileStreamParseBytes(stream, UInt32(data.count), base, [])
+        }
+        if status != noErr { failure = status }
+    }
+
+    /// The stream has ended: let the converter give up what it still holds.
+    func finish() {
+        guard let converter, let outputFormat else { return }
+        while true {
+            guard let pcm = AVAudioPCMBuffer(pcmFormat: outputFormat, frameCapacity: 4096) else { return }
+            var error: NSError?
+            let status = converter.convert(to: pcm, error: &error) { _, outStatus in
+                outStatus.pointee = .endOfStream
+                return nil
+            }
+            emit(pcm)
+            if status != .haveData || pcm.frameLength == 0 { return }
+        }
+    }
+
+    // MARK: - Callbacks, from AudioFileStreamParseBytes on the calling thread
+
+    fileprivate func propertyChanged(_ property: AudioFileStreamPropertyID) {
+        guard let stream else { return }
+        switch property {
+        case kAudioFileStreamProperty_DataFormat:
+            var description = AudioStreamBasicDescription()
+            var size = UInt32(MemoryLayout<AudioStreamBasicDescription>.size)
+            guard AudioFileStreamGetProperty(stream, property, &size, &description) == noErr else { return }
+            var mutable = description
+            guard
+                let input = AVAudioFormat(streamDescription: &mutable),
+                let output = AVAudioFormat(
+                    commonFormat: .pcmFormatFloat32,
+                    sampleRate: description.mSampleRate,
+                    channels: 1,
+                    interleaved: false
+                )
+            else { return }
+            inputFormat = input
+            outputFormat = output
+            converter = AVAudioConverter(from: input, to: output)
+            sampleRate = description.mSampleRate
+        case kAudioFileStreamProperty_PacketSizeUpperBound, kAudioFileStreamProperty_MaximumPacketSize:
+            var value: UInt32 = 0
+            var size = UInt32(MemoryLayout<UInt32>.size)
+            if AudioFileStreamGetProperty(stream, property, &size, &value) == noErr, value > 0 {
+                maxPacketSize = max(maxPacketSize, value)
+            }
+        case kAudioFileStreamProperty_PacketTableInfo:
+            // The LAME tag's priming frames: the silence the encoder put in
+            // front of the clip, which would otherwise be a gap per sentence.
+            var info = AudioFilePacketTableInfo()
+            var size = UInt32(MemoryLayout<AudioFilePacketTableInfo>.size)
+            if AudioFileStreamGetProperty(stream, property, &size, &info) == noErr {
+                toTrim = Int(info.mPrimingFrames)
+            }
+        default:
+            break
+        }
+    }
+
+    fileprivate func packetsArrived(
+        bytes: UInt32,
+        packets: UInt32,
+        data: UnsafeRawPointer,
+        descriptions: UnsafeMutablePointer<AudioStreamPacketDescription>?
+    ) {
+        guard
+            packets > 0,
+            let inputFormat, let outputFormat, let converter,
+            let descriptions
+        else { return }
+
+        let largest = (0..<Int(packets)).map { descriptions[$0].mDataByteSize }.max() ?? 0
+        let compressed = AVAudioCompressedBuffer(
+            format: inputFormat,
+            packetCapacity: AVAudioPacketCount(packets),
+            maximumPacketSize: Int(max(maxPacketSize, largest))
+        )
+        memcpy(compressed.data, data, Int(bytes))
+        compressed.byteLength = bytes
+        compressed.packetCount = AVAudioPacketCount(packets)
+        if let target = compressed.packetDescriptions {
+            target.update(from: descriptions, count: Int(packets))
+        }
+
+        // Room for every frame these packets can hold, at most 1,152 each.
+        let capacity = AVAudioFrameCount(packets) * 1152
+        var supplied = false
+        while true {
+            guard let pcm = AVAudioPCMBuffer(pcmFormat: outputFormat, frameCapacity: capacity) else { return }
+            var error: NSError?
+            let status = converter.convert(to: pcm, error: &error) { _, outStatus in
+                if supplied {
+                    outStatus.pointee = .noDataNow
+                    return nil
+                }
+                supplied = true
+                outStatus.pointee = .haveData
+                return compressed
+            }
+            if status == .error {
+                failure = OSStatus(truncatingIfNeeded: error?.code ?? -1)
+                return
+            }
+            emit(pcm)
+            // `.haveData` with a full buffer means more is waiting; anything
+            // else means the converter has handed over all it can for now.
+            if status != .haveData || pcm.frameLength < capacity { return }
+        }
+    }
+
+    private func emit(_ pcm: AVAudioPCMBuffer) {
+        let frames = Int(pcm.frameLength)
+        guard frames > 0, let channel = pcm.floatChannelData?[0] else { return }
+        if toTrim >= frames {
+            toTrim -= frames
+            return
+        }
+        let start = toTrim
+        toTrim = 0
+        let samples = Array(UnsafeBufferPointer(start: channel + start, count: frames - start))
+        if !samples.isEmpty { onPCM(samples, pcm.format.sampleRate) }
+    }
+}
