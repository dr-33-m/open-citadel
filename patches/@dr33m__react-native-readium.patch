diff --git a/ios/Reader/TTS/UpcomingUtterances.swift b/ios/Reader/TTS/UpcomingUtterances.swift
new file mode 100644
index 0000000000000000000000000000000000000000..ee2c9332939d7721c2bc3d955ea8a752d5cf93a7
--- /dev/null
+++ b/ios/Reader/TTS/UpcomingUtterances.swift
@@ -0,0 +1,97 @@
+import Foundation
+import ReadiumNavigator
+import ReadiumShared
+
+/// The utterances `PublicationSpeechSynthesizer` will speak after the one it
+/// has just started, so a voice whose audio is made in JS (an on-device
+/// model, or a cloud voice a network round trip away) can start on them
+/// early. iOS asks for an utterance only once the one before has finished
+/// playing, so without this every sentence starts late.
+///
+/// Walks the publication the way the synthesizer does (its iterator is
+/// private), with the same public pieces: `publication.content(from:)`, the
+/// synthesizer's own `defaultTokenizerFactory`, and its rule for which text
+/// is spoken (anything with a letter or a number). So the texts are the exact
+/// strings `speak` will be handed, across paragraph and resource boundaries.
+///
+/// Kept between calls: building an iterator parses the resource's HTML, too
+/// dear to repeat per sentence. Reading forward only drops what has been
+/// reached; a skip or a jump misses the window and starts afresh. Main-actor
+/// bound like `TTSManager`, which owns it, so calls never overlap.
+@MainActor
+final class UpcomingUtterances {
+    private struct Entry {
+        let text: String
+        let href: AnyURL
+        let highlight: String?
+        let before: String?
+
+        func matches(_ locator: Locator) -> Bool {
+            href == locator.href && highlight == locator.text.highlight && before == locator.text.before
+        }
+    }
+
+    private let publication: Publication
+    private var iterator: ContentIterator?
+    private var ahead: [Entry] = []
+
+    init(publication: Publication) {
+        self.publication = publication
+    }
+
+    /// Up to `count` utterance texts after `current`, the locator of the
+    /// utterance just started. `language` is what the synthesizer tokenizes
+    /// with: its configuration's default language, or the publication's.
+    func after(_ current: Locator, count: Int, language: Language?) async -> [String] {
+        if let reached = ahead.firstIndex(where: { $0.matches(current) }) {
+            ahead.removeFirst(reached + 1)
+        } else {
+            await reseek(current, language: language)
+        }
+        while ahead.count < count {
+            guard let element = try? await iterator?.next() else { break }
+            ahead.append(contentsOf: utterances(of: element, language: language))
+        }
+        return ahead.prefix(count).map(\.text)
+    }
+
+    func reset() {
+        iterator = nil
+        ahead = []
+    }
+
+    private func reseek(_ current: Locator, language: Language?) async {
+        ahead = []
+        iterator = publication.content(from: current)?.iterator()
+        guard let first = try? await iterator?.next() else { return }
+        let entries = utterances(of: first, language: language)
+        // Not found means this element was cut differently from the one being
+        // read; its remainder is left out rather than guessed.
+        if let index = entries.firstIndex(where: { $0.matches(current) }) {
+            ahead = Array(entries[(index + 1)...])
+        }
+    }
+
+    /// The utterances one element yields, as the synthesizer's own
+    /// `utterances(for:)` makes them.
+    private func utterances(of element: ContentElement, language: Language?) -> [Entry] {
+        let tokenize = PublicationSpeechSynthesizer.defaultTokenizerFactory(language)
+        let tokens = (try? tokenize(element)) ?? []
+        return tokens.flatMap { token -> [Entry] in
+            switch token {
+            case let text as TextContentElement:
+                return text.segments.compactMap { entry(text: $0.text, locator: $0.locator) }
+            case let textual as TextualContentElement:
+                guard let text = textual.text, !text.isEmpty else { return [] }
+                return [entry(text: text, locator: textual.locator)].compactMap { $0 }
+            default:
+                return []
+            }
+        }
+    }
+
+    private func entry(text: String, locator: Locator) -> Entry? {
+        guard text.contains(where: { $0.isLetter || $0.isNumber }) else { return nil }
+        return Entry(text: text, href: locator.href, highlight: locator.text.highlight, before: locator.text.before)
+    }
+}
