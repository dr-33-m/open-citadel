+++ b/android/src/main/java/com/reactnativereadium/reader/tts/KokoroTtsEngine.kt
@@ -0,0 +1,313 @@
+package com.reactnativereadium.reader.tts
+
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import java.util.concurrent.Executors
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import org.readium.navigator.media.tts.TtsEngine
+import org.readium.r2.shared.util.Language
+
+/**
+ * [TtsEngine] that hands each utterance to JS for synthesis — Kokoro's model
+ * runs in `react-native-executorch`'s JS layer, not natively — and plays the
+ * returned PCM back itself via a streaming [AudioTrack].
+ *
+ * Unlike [org.readium.navigator.media.tts.android.AndroidTtsEngine], `speak`
+ * has nothing to synthesize itself: it emits [onSynthesisRequest] and waits
+ * for [provideAudioChunk] calls answering it, driven by
+ * `HybridReadiumView.ttsProvideAudioChunk`.
+ */
+public class KokoroTtsEngine(
+    initialPreferences: KokoroTtsPreferences,
+) : TtsEngine<KokoroTtsSettings, KokoroTtsPreferences, KokoroTtsEngine.Error, KokoroTtsEngine.Voice> {
+
+    public companion object {
+        public val VOICES: List<Voice> = listOf(
+            Voice("af_heart", Language("en-US")),
+            Voice("af_river", Language("en-US")),
+            Voice("af_sarah", Language("en-US")),
+            Voice("am_adam", Language("en-US")),
+            Voice("am_michael", Language("en-US")),
+            Voice("am_santa", Language("en-US")),
+            Voice("bf_emma", Language("en-GB")),
+            Voice("bm_daniel", Language("en-GB")),
+        )
+    }
+
+    public data class Voice(val id: String, override val language: Language) : TtsEngine.Voice
+
+    public sealed class Error(
+        override val message: String,
+        override val cause: org.readium.r2.shared.util.Error? = null,
+    ) : TtsEngine.Error {
+        public class SynthesisFailed(message: String) : Error(message)
+    }
+
+    /** Emits a request for JS to synthesize `text`. Set by `TTSManager`. */
+    public var onSynthesisRequest: ((requestId: String, text: String, language: String?, voice: String?, speed: Double) -> Unit)? = null
+    /** A previously requested synthesis is no longer needed (interrupted or superseded). */
+    public var onSynthesisCancel: ((requestId: String) -> Unit)? = null
+
+    override val voices: Set<Voice> = VOICES.toSet()
+
+    private var listener: TtsEngine.Listener<Error>? = null
+    private var preferences: KokoroTtsPreferences = initialPreferences
+    private val settingsMutable = MutableStateFlow(preferences.toSettings())
+    override val settings: StateFlow<KokoroTtsSettings> = settingsMutable
+
+    // `@Volatile`: read from `writeQueue`'s thread (the check in the queued
+    // write below), written from whatever thread calls `speak`/`stop` — a
+    // plain `var` gives no guarantee the write sees a stop that already
+    // happened.
+    @Volatile
+    private var activeRequestId: String? = null
+    // `@Volatile` since encoded audio reaches `provideAudioChunk` from the
+    // decode thread rather than JS's: see `provideEncodedAudio`.
+    @Volatile
+    private var requestStarted: Boolean = false
+    private var audioTrack: AudioTrack? = null
+    private var trackSampleRate: Int = 0
+
+    /**
+     * Runs every [AudioTrack.write] in order, off whatever thread calls
+     * [provideAudioChunk].
+     *
+     * That thread is JS's: `provideAudioChunk` is a synchronous Nitro method,
+     * called straight from `HybridReadiumView.ttsProvideAudioChunk` with no
+     * Promise in between, so whatever blocks in here blocks the JS thread.
+     * `AudioTrack.write(..., WRITE_BLOCKING)` blocks until the track's buffer
+     * has room, which — once that buffer is as full as streaming playback
+     * keeps it — is roughly "however long until the audio already queued has
+     * finished playing." With the write on the calling thread, that pinned
+     * JS for the same stretch: every native→JS call that thread needed to
+     * dispatch also had to wait its turn, including the pause state-change
+     * `TTSManager.observeNavigator` sends to `onTTSStateChange` and the tap
+     * that asked for it in the first place — which is what made pause look
+     * like it was waiting for the sentence to finish. `AudioTrack`'s own
+     * write/control split (one thread writes, another calls
+     * play/pause/flush) is the documented way to use it concurrently, so
+     * moving only the write here needs no lock around the rest of this class.
+     */
+    private val writeQueue = Executors.newSingleThreadExecutor()
+
+    /**
+     * Decodes encoded answers (MP3 from a cloud voice) off JS's thread, in
+     * order, one utterance at a time. Decoded audio goes on through
+     * [provideAudioChunk] exactly as PCM from JS does, so playback, "done"
+     * and interruption are the same code either way.
+     */
+    private val decodeQueue = Executors.newSingleThreadExecutor()
+    /** Only touched on [decodeQueue]. */
+    private var decoder: Mp3StreamDecoder? = null
+    private var decoderRequestId: String? = null
+
+    override fun submitPreferences(preferences: KokoroTtsPreferences) {
+        this.preferences = preferences
+        settingsMutable.value = preferences.toSettings()
+    }
+
+    private fun KokoroTtsPreferences.toSettings() = KokoroTtsSettings(
+        language = language,
+        overrideContentLanguage = language != null,
+        voice = voice ?: VOICES.first().id,
+        speed = speed ?: 1.0,
+    )
+
+    override fun speak(requestId: TtsEngine.RequestId, text: String, language: Language?) {
+        activeRequestId = requestId.value
+        requestStarted = false
+        val current = settingsMutable.value
+        onSynthesisRequest?.invoke(
+            requestId.value,
+            text,
+            (language ?: current.language)?.code,
+            current.voice,
+            current.speed,
+        )
+    }
+
+    override fun stop() {
+        val id = activeRequestId ?: return
+        activeRequestId = null
+        decodeQueue.execute { releaseDecoder() }
+        stopPlayback()
+        onSynthesisCancel?.invoke(id)
+        listener?.onInterrupted(TtsEngine.RequestId(id))
+    }
+
+    override fun setListener(listener: TtsEngine.Listener<Error>?) {
+        this.listener = listener
+    }
+
+    override fun close() {
+        stopPlayback()
+        audioTrack?.release()
+        audioTrack = null
+        // Safe to drop queued writes outright: `stopPlayback()` above already
+        // flushed the track they were headed for, and `KokoroTtsEngineProvider`
+        // makes a fresh engine (and so a fresh queue) for the next session.
+        writeQueue.shutdownNow()
+        decodeQueue.execute { releaseDecoder() }
+        decodeQueue.shutdown()
+    }
+
+    /**
+     * Answers an in-flight [onSynthesisRequest] with one chunk of mono Float32
+     * PCM. Called from `HybridReadiumView.ttsProvideAudioChunk`.
+     */
+    public fun provideAudioChunk(requestId: String, samples: FloatArray, sampleRate: Int, isLast: Boolean) {
+        val id = activeRequestId ?: return
+        if (id != requestId) return
+
+        if (samples.isEmpty() && isLast && !requestStarted) {
+            activeRequestId = null
+            listener?.onStart(TtsEngine.RequestId(id))
+            listener?.onDone(TtsEngine.RequestId(id))
+            return
+        }
+        val track = ensureAudioTrack(sampleRate)
+        if (!requestStarted) {
+            requestStarted = true
+            listener?.onStart(TtsEngine.RequestId(id))
+        }
+
+        // See `writeQueue`'s own doc: this is the call that must not block
+        // the thread `provideAudioChunk` was called on. Re-checks
+        // `activeRequestId` once it actually runs — `stop()`/a superseding
+        // `speak()` can land while this sits behind an earlier chunk still
+        // writing, and a track already flushed for the next utterance should
+        // not receive this one's leftover audio.
+        writeQueue.execute {
+            if (activeRequestId != requestId) return@execute
+            track.write(samples, 0, samples.size, AudioTrack.WRITE_BLOCKING)
+            if (isLast && activeRequestId == requestId) {
+                // Signals "done" the moment this utterance's last byte is
+                // queued, not once the track has actually played it —
+                // `AudioTrack.setNotificationMarkerPosition`, which this used
+                // to wait on, silently never fires for some marker positions
+                // on some devices (an old, well-documented AudioTrack quirk,
+                // and more exposed the longer the same streaming track has
+                // been reused, which is every book after its first page).
+                // When it doesn't fire, the navigator never asks for the next
+                // utterance and the book just stops — no error, nothing to
+                // recover from short of the reader skipping manually. Firing
+                // here loses nothing audible: the next utterance's audio
+                // still queues onto this same continuous track right behind
+                // this one, so playback stays gapless regardless of when JS
+                // is told it may start on it.
+                activeRequestId = null
+                listener?.onDone(TtsEngine.RequestId(requestId))
+            }
+        }
+    }
+
+    /**
+     * Answers an in-flight [onSynthesisRequest] with a chunk of encoded audio
+     * (`audio/mpeg`), decoded here as it arrives. Chunks may split frames
+     * anywhere; the last one carries [isLast]. Called from
+     * `HybridReadiumView.ttsProvideEncodedAudio` on JS's thread, so the work
+     * goes straight to [decodeQueue].
+     */
+    public fun provideEncodedAudio(requestId: String, bytes: ByteArray, mimeType: String, isLast: Boolean) {
+        if (activeRequestId != requestId) return
+        if (mimeType != Mp3StreamDecoder.MIME) {
+            synthesisFailed(requestId, "Cannot decode $mimeType")
+            return
+        }
+        decodeQueue.execute {
+            if (activeRequestId != requestId) {
+                releaseDecoder()
+                return@execute
+            }
+            if (decoderRequestId != requestId) {
+                releaseDecoder()
+                decoderRequestId = requestId
+                decoder = Mp3StreamDecoder { samples, rate -> provideAudioChunk(requestId, samples, rate, false) }
+            }
+            val current = decoder ?: return@execute
+            try {
+                current.feed(bytes)
+                if (isLast) {
+                    current.finish()
+                    val rate = current.sampleRate.takeIf { it > 0 } ?: trackSampleRate.takeIf { it > 0 } ?: 24_000
+                    releaseDecoder()
+                    provideAudioChunk(requestId, FloatArray(0), rate, true)
+                }
+            } catch (e: Exception) {
+                // A stream the decoder cannot read. Whatever was decoded has
+                // played; the utterance ends there rather than stalling the
+                // book, and the next one is asked for as usual.
+                android.util.Log.w("KokoroTtsEngine", "MP3 decode failed: ${e.message}")
+                val rate = current.sampleRate.takeIf { it > 0 } ?: trackSampleRate.takeIf { it > 0 } ?: 24_000
+                releaseDecoder()
+                provideAudioChunk(requestId, FloatArray(0), rate, true)
+            }
+        }
+    }
+
+    /** Only on [decodeQueue]. */
+    private fun releaseDecoder() {
+        decoder?.release()
+        decoder = null
+        decoderRequestId = null
+    }
+
+    /** Answers an in-flight [onSynthesisRequest] that could not be fulfilled. */
+    public fun synthesisFailed(requestId: String, message: String) {
+        val id = activeRequestId ?: return
+        if (id != requestId) return
+        activeRequestId = null
+        stopPlayback()
+        listener?.onError(TtsEngine.RequestId(id), Error.SynthesisFailed(message))
+    }
+
+    private fun ensureAudioTrack(sampleRate: Int): AudioTrack {
+        audioTrack?.let {
+            if (trackSampleRate == sampleRate) {
+                // stop() pauses and flushes this track. Reusing it without
+                // play() makes resumed or skipped speech silently disappear.
+                if (it.playState != AudioTrack.PLAYSTATE_PLAYING) it.play()
+                return it
+            }
+        }
+
+        audioTrack?.release()
+        trackSampleRate = sampleRate
+        val minBufferBytes = AudioTrack.getMinBufferSize(
+            sampleRate,
+            AudioFormat.CHANNEL_OUT_MONO,
+            AudioFormat.ENCODING_PCM_FLOAT,
+        )
+        val track = AudioTrack.Builder()
+            .setAudioAttributes(
+                AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_MEDIA)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                    .build(),
+            )
+            .setAudioFormat(
+                AudioFormat.Builder()
+                    .setEncoding(AudioFormat.ENCODING_PCM_FLOAT)
+                    .setSampleRate(sampleRate)
+                    .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                    .build(),
+            )
+            // One second of headroom beyond the platform minimum, since chunks
+            // arrive from a JS round-trip rather than a tight native loop.
+            .setBufferSizeInBytes(minBufferBytes.coerceAtLeast(sampleRate * Float.SIZE_BYTES))
+            .setTransferMode(AudioTrack.MODE_STREAM)
+            .build()
+        track.play()
+        audioTrack = track
+        return track
+    }
+
+    private fun stopPlayback() {
+        audioTrack?.let {
+            it.pause()
+            it.flush()
+        }
+    }
+}
