+        if isLast {
+            finishScheduling(requestId: requestId)
+        }
+    }
+
+    /// Answers a request with a chunk of encoded audio (`audio/mpeg`), decoded
+    /// here as it arrives and scheduled exactly as PCM from JS is. Chunks may
+    /// split packets anywhere; the last one carries `isLast`.
+    func provideEncodedAudio(requestId: String, data: Data, mimeType: String, isLast: Bool) {
+        guard let task = tasks[requestId], !task.isCancelled else {
+            if decoderRequestId == requestId { releaseDecoder() }
+            return
+        }
+        guard mimeType == Mp3StreamDecoder.mimeType else {
+            synthesisFailed(requestId: requestId, message: "Cannot decode \(mimeType)")
+            return
+        }
+        if decoderRequestId != requestId {
+            releaseDecoder()
+            decoderRequestId = requestId
+            decoder = Mp3StreamDecoder { [weak self] samples, sampleRate in
+                // Called synchronously from `feed`/`finish` below, which run
+                // on the main actor; the decoder itself is not actor-bound.
+                MainActor.assumeIsolated {
+                    let pcm = samples.withUnsafeBufferPointer { Data(buffer: $0) }
+                    self?.provideAudioChunk(requestId: requestId, samples: pcm, sampleRate: sampleRate, isLast: false)
+                }
+            }
+        }
+        guard let current = decoder else { return }
+        current.feed(data)
+        if isLast || current.failure != noErr {
+            // A stream the decoder cannot read ends the utterance where it
+            // stopped rather than stalling the book; the next is asked for as usual.
+            current.finish()
+            let rate = current.sampleRate > 0 ? current.sampleRate : (connectedSampleRate ?? 24_000)
+            releaseDecoder()
+            provideAudioChunk(requestId: requestId, samples: Data(), sampleRate: rate, isLast: true)
+        }
+    }
+
+    private func releaseDecoder() {
+        decoder = nil
+        decoderRequestId = nil
+    }
+
+    /// Whether `requestId` is still waiting for its answer.
+    func isWaiting(for requestId: String) -> Bool {
+        guard let task = tasks[requestId] else { return false }
+        return !task.isCancelled
+    }
+
+    func synthesisFailed(requestId: String, message: String) {
+        finishTask(requestId: requestId, result: .failure(.other(
+            NSError(domain: "KokoroTTSEngine", code: -1, userInfo: [NSLocalizedDescriptionKey: message])
+        )))
+    }
+
+    private func finishScheduling(requestId: String) {
+        guard let task = tasks[requestId] else { return }
+        task.isLastScheduled = true
+        if task.completedBuffers >= task.scheduledBuffers {
+            finishTask(requestId: requestId, result: .success(()))
+        }
+    }
+
+    private func onBufferCompleted(requestId: String) {
+        guard let task = tasks[requestId] else { return }
+        task.completedBuffers += 1
+        if task.isLastScheduled, task.completedBuffers >= task.scheduledBuffers {
+            finishTask(requestId: requestId, result: .success(()))
+        }
+    }
+
+    private func cancelTask(requestId: String) {
+        guard let task = tasks[requestId], !task.isCancelled else { return }
+        task.isCancelled = true
+        // Readium considers the utterance interrupted the moment this method
+        // returns, but nothing else here ever told the player to stop — buffers
+        // already scheduled for this task would keep playing to completion on
+        // their own, so a pause only took effect once the sentence finished.
+        // `stop()` halts playback immediately and drops every pending buffer
+        // and completion callback, which is safe since only one task is ever
+        // scheduling audio on this shared node at a time.
+        playerNode.stop()
+        onSynthesisCancel?(requestId)
+        finishTask(requestId: requestId, result: .success(()))
+    }
+
+    private func finishTask(requestId: String, result: Result<Void, TTSError>) {
+        guard let task = tasks.removeValue(forKey: requestId) else { return }
+        task.continuation?.resume(returning: result)
+        task.continuation = nil
+    }
+}
