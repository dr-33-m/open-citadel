+++ b/android/src/main/java/com/reactnativereadium/reader/tts/UpcomingUtterances.kt
@@ -0,0 +1,141 @@
+package com.reactnativereadium.reader.tts
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.readium.r2.shared.ExperimentalReadiumApi
+import org.readium.r2.shared.publication.Locator
+import org.readium.r2.shared.publication.Publication
+import org.readium.r2.shared.publication.services.content.Content
+import org.readium.r2.shared.publication.services.content.ContentService
+import org.readium.r2.shared.publication.services.content.TextContentTokenizer
+import org.readium.r2.shared.util.Language
+import org.readium.r2.shared.util.tokenizer.DefaultTextContentTokenizer
+import org.readium.r2.shared.util.tokenizer.TextUnit
+
+/**
+ * The utterances Readium will ask for after the one it has just started.
+ *
+ * Readium's TTS asks the engine for one utterance at a time, only when it is
+ * due, and its own iterator (`TtsUtteranceIterator`) is internal. A voice
+ * whose audio is made in JS (an on-device model, or a cloud voice a network
+ * round trip away) then starts every sentence late. This walks the
+ * publication the same way that iterator does, with the same public pieces:
+ * the publication's [ContentService], a [TextContentTokenizer] over the same
+ * sentence tokenizer `TtsNavigatorFactory` uses by default, and the same
+ * rule for which text is spoken (anything with a letter or a digit). So the
+ * texts it returns are the exact strings `speak` will be handed, across
+ * paragraph and resource boundaries.
+ *
+ * Kept between calls rather than rebuilt for every sentence: building a
+ * content iterator parses the resource's HTML, which is too dear to do per
+ * sentence on a slower phone. While reading runs forward, each call only
+ * drops what has been reached and reads the next element if more is needed.
+ * A skip, a jump or a seek misses the window and starts a fresh iterator at
+ * the new utterance.
+ *
+ * Not thread-safe, like the iterator it mirrors: `TTSManager` calls it from
+ * one coroutine at a time.
+ */
+@OptIn(ExperimentalReadiumApi::class)
+internal class UpcomingUtterances(private val publication: Publication) {
+
+    private data class Entry(
+        val text: String,
+        val href: String,
+        val highlight: String?,
+        val before: String?,
+    ) {
+        fun matches(locator: Locator): Boolean =
+            href == locator.href.toString() &&
+                highlight == locator.text.highlight &&
+                before == locator.text.before
+    }
+
+    private var iterator: Content.Iterator? = null
+    private val ahead = ArrayDeque<Entry>()
+
+    /**
+     * Up to [count] utterance texts after [current], the utterance locator
+     * Readium just reported. [language] and [overrideContentLanguage] are the
+     * TTS settings' own, which is what Readium tokenizes with.
+     */
+    suspend fun after(
+        current: Locator,
+        count: Int,
+        language: Language?,
+        overrideContentLanguage: Boolean,
+    ): List<String> = withContext(Dispatchers.Default) {
+        val reached = ahead.indexOfFirst { it.matches(current) }
+        if (reached >= 0) {
+            repeat(reached + 1) { ahead.removeFirst() }
+        } else {
+            reseek(current, language, overrideContentLanguage)
+        }
+        while (ahead.size < count) {
+            val element = iterator?.nextOrNull() ?: break
+            ahead.addAll(utterancesOf(element, language, overrideContentLanguage))
+        }
+        ahead.take(count).map { it.text }
+    }
+
+    /** Forget everything: a new book position, or TTS stopping. */
+    fun reset() {
+        iterator = null
+        ahead.clear()
+    }
+
+    private suspend fun reseek(current: Locator, language: Language?, overrideContentLanguage: Boolean) {
+        ahead.clear()
+        val service = publication.findService(ContentService::class)
+        if (service == null) {
+            iterator = null
+            return
+        }
+        // Starts at the element holding the utterance, as Readium's own does
+        // for an initial locator; the utterances before it in that element
+        // are dropped below.
+        val fresh = service.content(current).iterator()
+        iterator = fresh
+        val first = fresh.nextOrNull() ?: return
+        val entries = utterancesOf(first, language, overrideContentLanguage)
+        val index = entries.indexOfFirst { it.matches(current) }
+        // Not found means this element was cut differently from the one
+        // Readium is reading; its remainder is left out rather than guessed,
+        // and the lookahead picks up again at the next element.
+        if (index >= 0) ahead.addAll(entries.subList(index + 1, entries.size))
+    }
+
+    /** The utterances one element yields, as `TtsUtteranceIterator.utterances()` makes them. */
+    private fun utterancesOf(
+        element: Content.Element,
+        language: Language?,
+        overrideContentLanguage: Boolean,
+    ): List<Entry> {
+        val tokenizer = TextContentTokenizer(
+            language = language,
+            textTokenizerFactory = { lang -> DefaultTextContentTokenizer(TextUnit.Sentence, lang) },
+            overrideContentLanguage = overrideContentLanguage,
+        )
+        return tokenizer.tokenize(element).flatMap { token ->
+            when (token) {
+                is Content.TextElement -> token.segments.mapNotNull { segment ->
+                    entry(segment.text, segment.locator)
+                }
+                is Content.TextualElement -> listOfNotNull(
+                    token.text?.takeIf { it.isNotBlank() }?.let { entry(it, token.locator) },
+                )
+                else -> emptyList()
+            }
+        }
+    }
+
+    private fun entry(text: String, locator: Locator): Entry? {
+        if (!text.any { it.isLetterOrDigit() }) return null
+        return Entry(
+            text = text,
+            href = locator.href.toString(),
+            highlight = locator.text.highlight,
+            before = locator.text.before,
+        )
+    }
+}
