diff --git a/android/src/main/java/com/reactnativereadium/reader/tts/Mp3Frames.kt b/android/src/main/java/com/reactnativereadium/reader/tts/Mp3Frames.kt
new file mode 100644
index 0000000000000000000000000000000000000000..0f28e4fb9d8cc06e384a8b21e8b4d3d132b1ce6b
--- /dev/null
+++ b/android/src/main/java/com/reactnativereadium/reader/tts/Mp3Frames.kt
@@ -0,0 +1,200 @@
+package com.reactnativereadium.reader.tts
+
+/**
+ * MPEG audio layer III, cut into whole frames as it streams in.
+ *
+ * Android's MP3 decoder takes one frame per input buffer, but the network
+ * hands over bytes wherever a packet happens to end. This keeps the tail of
+ * each chunk until the next completes it, skips an ID3v2 tag at the start,
+ * and reads the encoder's own delay from a LAME tag so the silence an
+ * encoder puts in front of every clip can be cut: a cloud voice reads one
+ * clip per sentence, and an uncut delay is a gap between every two.
+ *
+ * Pure Kotlin with no Android in it, so it can be tested on its own.
+ */
+internal data class Mp3Header(
+    /** 1 for MPEG-1, 2 for MPEG-2, 25 for MPEG-2.5. */
+    val version: Int,
+    val bitrateKbps: Int,
+    val sampleRate: Int,
+    val channels: Int,
+    val frameLength: Int,
+    val samplesPerFrame: Int,
+    /** The length of the side information, which a Xing or Info tag follows. */
+    val sideInfoLength: Int,
+)
+
+internal class Mp3Frame(val bytes: ByteArray, val header: Mp3Header)
+
+private val BITRATES_V1_L3 = intArrayOf(0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320)
+private val BITRATES_V2_L3 = intArrayOf(0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160)
+private val RATES_V1 = intArrayOf(44100, 48000, 32000)
+private val RATES_V2 = intArrayOf(22050, 24000, 16000)
+private val RATES_V25 = intArrayOf(11025, 12000, 8000)
+
+/** A layer III frame header at [offset], or null when the bytes there are not one. */
+internal fun parseMp3Header(data: ByteArray, offset: Int): Mp3Header? {
+    if (offset + 4 > data.size) return null
+    val b0 = data[offset].toInt() and 0xFF
+    val b1 = data[offset + 1].toInt() and 0xFF
+    val b2 = data[offset + 2].toInt() and 0xFF
+    val b3 = data[offset + 3].toInt() and 0xFF
+    if (b0 != 0xFF || (b1 and 0xE0) != 0xE0) return null
+    val version = when ((b1 shr 3) and 0x03) {
+        0 -> 25
+        2 -> 2
+        3 -> 1
+        else -> return null
+    }
+    if (((b1 shr 1) and 0x03) != 1) return null // layer III only
+    val bitrateIndex = (b2 shr 4) and 0x0F
+    val rateIndex = (b2 shr 2) and 0x03
+    if (bitrateIndex == 0 || bitrateIndex == 15 || rateIndex == 3) return null
+    val padding = (b2 shr 1) and 0x01
+    val mono = ((b3 shr 6) and 0x03) == 3
+    val bitrate = (if (version == 1) BITRATES_V1_L3 else BITRATES_V2_L3)[bitrateIndex]
+    val sampleRate = when (version) {
+        1 -> RATES_V1
+        2 -> RATES_V2
+        else -> RATES_V25
+    }[rateIndex]
+    val frameLength = (if (version == 1) 144 else 72) * bitrate * 1000 / sampleRate + padding
+    return Mp3Header(
+        version = version,
+        bitrateKbps = bitrate,
+        sampleRate = sampleRate,
+        channels = if (mono) 1 else 2,
+        frameLength = frameLength,
+        samplesPerFrame = if (version == 1) 1152 else 576,
+        sideInfoLength = if (version == 1) (if (mono) 17 else 32) else (if (mono) 9 else 17),
+    )
+}
+
+internal class Mp3FrameSplitter {
+    private var pending = ByteArray(0)
+    private var started = false
+    /**
+     * The last frame ended exactly where the next begins. In sync, a header
+     * is trusted where it stands; only while searching for one does a sync
+     * word have to be confirmed by the frame after it. A clip starts on a
+     * frame (after any ID3 tag), so it starts in sync.
+     */
+    private var inSync = true
+
+    /**
+     * Samples of encoder delay to cut from the start, read from a LAME tag in
+     * the first frame. Zero when the clip has none.
+     */
+    var encoderDelay: Int = 0
+        private set
+
+    /** Every whole frame the bytes so far complete, in order. */
+    fun push(bytes: ByteArray): List<Mp3Frame> {
+        pending = if (pending.isEmpty()) bytes.copyOf() else pending + bytes
+        return drain(final = false)
+    }
+
+    /** The frames left once the stream has ended, including a last one nothing follows. */
+    fun finish(): List<Mp3Frame> = drain(final = true)
+
+    private fun drain(final: Boolean): List<Mp3Frame> {
+        val frames = ArrayList<Mp3Frame>()
+        var at = 0
+        if (!started) {
+            val skip = id3Length(pending) ?: return frames // not enough bytes to tell yet
+            if (pending.size < skip) {
+                if (!final) return frames
+                pending = ByteArray(0)
+                return frames
+            }
+            at = skip
+        }
+        while (true) {
+            val header = parseMp3Header(pending, at)
+            if (header == null) {
+                // Not on a frame: step one byte and look again. A real stream
+                // only lands here on junk between frames, or a chunk that
+                // ended inside a header.
+                if (at + 4 > pending.size) break
+                inSync = false
+                at++
+                continue
+            }
+            val end = at + header.frameLength
+            if (end > pending.size) break
+            // A sync word can occur inside audio data by chance. Where the
+            // next frame's start is in hand it must be a header too; at the
+            // very end of the stream there is nothing to check against.
+            val nextInHand = end + 4 <= pending.size
+            if (!inSync && nextInHand && parseMp3Header(pending, end) == null && !final) {
+                at++
+                continue
+            }
+            inSync = true
+            val frame = pending.copyOfRange(at, end)
+            if (!started) {
+                started = true
+                val delay = lameEncoderDelay(frame, header)
+                if (delay != null) {
+                    // The tag frame carries no audio; it is metadata dressed
+                    // as a frame, and decoding it is a frame of silence.
+                    encoderDelay = delay
+                    at = end
+                    continue
+                }
+            }
+            frames.add(Mp3Frame(frame, header))
+            at = end
+        }
+        pending = if (at >= pending.size) ByteArray(0) else pending.copyOfRange(at, pending.size)
+        if (final) pending = ByteArray(0)
+        return frames
+    }
+
+    /**
+     * How many bytes of ID3v2 tag start the stream (0 for none), or null when
+     * too few bytes have arrived to say.
+     */
+    private fun id3Length(data: ByteArray): Int? {
+        if (data.size < 10) return if (data.size >= 3 && !startsWithId3(data)) 0 else null
+        if (!startsWithId3(data)) return 0
+        val flags = data[5].toInt() and 0xFF
+        val size = ((data[6].toInt() and 0x7F) shl 21) or
+            ((data[7].toInt() and 0x7F) shl 14) or
+            ((data[8].toInt() and 0x7F) shl 7) or
+            (data[9].toInt() and 0x7F)
+        val footer = if ((flags and 0x10) != 0) 10 else 0
+        return 10 + size + footer
+    }
+
+    private fun startsWithId3(data: ByteArray): Boolean =
+        data[0] == 'I'.code.toByte() && data[1] == 'D'.code.toByte() && data[2] == '3'.code.toByte()
+}
+
+/**
+ * The encoder delay a Xing or Info frame's LAME tag records, or null when the
+ * frame is ordinary audio. A Xing or Info frame without a LAME tag still
+ * counts as a tag frame, with no delay to cut.
+ */
+internal fun lameEncoderDelay(frame: ByteArray, header: Mp3Header): Int? {
+    val tagAt = 4 + header.sideInfoLength
+    if (tagAt + 8 > frame.size) return null
+    val tag = String(frame, tagAt, 4, Charsets.US_ASCII)
+    if (tag != "Xing" && tag != "Info") return null
+    val flags = ((frame[tagAt + 4].toInt() and 0xFF) shl 24) or
+        ((frame[tagAt + 5].toInt() and 0xFF) shl 16) or
+        ((frame[tagAt + 6].toInt() and 0xFF) shl 8) or
+        (frame[tagAt + 7].toInt() and 0xFF)
+    var at = tagAt + 8
+    if ((flags and 0x1) != 0) at += 4 // frame count
+    if ((flags and 0x2) != 0) at += 4 // byte count
+    if ((flags and 0x4) != 0) at += 100 // table of contents
+    if ((flags and 0x8) != 0) at += 4 // quality
+    // The LAME extension: a nine-byte encoder name, then the delay and the
+    // padding as two twelve-bit numbers at byte 21 of it.
+    if (at + 24 > frame.size) return 0
+    if (String(frame, at, 4, Charsets.US_ASCII) != "LAME" && String(frame, at, 4, Charsets.US_ASCII) != "Lavc") return 0
+    val b0 = frame[at + 21].toInt() and 0xFF
+    val b1 = frame[at + 22].toInt() and 0xFF
+    return (b0 shl 4) or (b1 shr 4)
+}
diff --git a/android/src/main/java/com/reactnativereadium/reader/tts/Mp3StreamDecoder.kt b/android/src/main/java/com/reactnativereadium/reader/tts/Mp3StreamDecoder.kt
new file mode 100644
index 0000000000000000000000000000000000000000..8623fb6c1715f7701c9aca97e068ec04730a6350
--- /dev/null
+++ b/android/src/main/java/com/reactnativereadium/reader/tts/Mp3StreamDecoder.kt
@@ -0,0 +1,191 @@
+package com.reactnativereadium.reader.tts
+
+import android.media.AudioFormat
+import android.media.MediaCodec
+import android.media.MediaCodecList
+import android.media.MediaFormat
+import java.nio.ByteOrder
+
+/**
+ * One utterance of MP3, decoded to mono Float32 as it streams in.
+ *
+ * A cloud voice can answer in MP3, about a tenth of the size of the raw PCM
+ * it would otherwise send, which is the difference between roughly 173 MB
+ * and 17 MB an hour over the network and in the phone's cache. JS cannot
+ * decode MP3 at any useful speed, so it hands the bytes over as they arrive
+ * and this decodes them with the platform's own decoder ([MediaCodec]),
+ * frame by frame, so the first words play while the rest is still coming.
+ *
+ * Not thread-safe: `KokoroTtsEngine` drives one of these at a time from its
+ * own decode thread, never from JS's.
+ */
+internal class Mp3StreamDecoder(
+    /** Decoded audio, mono Float32, at the stream's own sample rate. */
+    private val onPcm: (samples: FloatArray, sampleRate: Int) -> Unit,
+) {
+    companion object {
+        const val MIME = "audio/mpeg"
+
+        /** Whether this phone has an MP3 decoder at all. Every Android phone should. */
+        fun isSupported(): Boolean = try {
+            MediaCodecList(MediaCodecList.REGULAR_CODECS)
+                .findDecoderForFormat(MediaFormat.createAudioFormat(MediaFormat.MIMETYPE_AUDIO_MPEG, 24_000, 1)) != null
+        } catch (_: Exception) {
+            false
+        }
+
+        private const val INPUT_TIMEOUT_US = 10_000L
+        private const val DRAIN_TIMEOUT_US = 10_000L
+        /** How long `finish` waits for the decoder's last frames, in drain attempts. */
+        private const val FINAL_DRAIN_ATTEMPTS = 300
+    }
+
+    private val splitter = Mp3FrameSplitter()
+    private var codec: MediaCodec? = null
+    private var presentationUs = 0L
+    private var outputRate = 0
+    private var outputChannels = 1
+    private var outputFloat = false
+    /** Samples of encoder delay still to cut from the start of the output. */
+    private var toTrim = 0
+    private var trimRead = false
+    private val info = MediaCodec.BufferInfo()
+
+    /** The sample rate of the audio produced so far, or 0 before any. */
+    val sampleRate: Int get() = outputRate
+
+    fun feed(bytes: ByteArray) {
+        for (frame in splitter.push(bytes)) queue(frame)
+    }
+
+    /** The stream has ended: decode what is left and let the decoder empty itself. */
+    fun finish() {
+        for (frame in splitter.finish()) queue(frame)
+        val decoder = codec ?: return
+        var queued = false
+        var attempts = 0
+        while (!queued && attempts++ < FINAL_DRAIN_ATTEMPTS) {
+            val index = decoder.dequeueInputBuffer(INPUT_TIMEOUT_US)
+            if (index >= 0) {
+                decoder.queueInputBuffer(index, 0, 0, presentationUs, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
+                queued = true
+            } else {
+                drain(0)
+            }
+        }
+        attempts = 0
+        while (attempts++ < FINAL_DRAIN_ATTEMPTS) {
+            if (drain(DRAIN_TIMEOUT_US)) break
+        }
+    }
+
+    fun release() {
+        codec?.let {
+            try {
+                it.stop()
+            } catch (_: Exception) {
+                // Already stopped, or never started.
+            }
+            it.release()
+        }
+        codec = null
+    }
+
+    private fun ensureCodec(header: Mp3Header): MediaCodec {
+        codec?.let { return it }
+        val format = MediaFormat.createAudioFormat(MediaFormat.MIMETYPE_AUDIO_MPEG, header.sampleRate, header.channels)
+        val created = MediaCodec.createDecoderByType(MediaFormat.MIMETYPE_AUDIO_MPEG)
+        created.configure(format, null, null, 0)
+        created.start()
+        codec = created
+        outputRate = header.sampleRate
+        outputChannels = header.channels
+        return created
+    }
+
+    private fun queue(frame: Mp3Frame) {
+        if (!trimRead) {
+            // The splitter reads the LAME tag before it hands over the first
+            // audio frame, so the delay is known by now.
+            trimRead = true
+            toTrim = splitter.encoderDelay
+        }
+        val decoder = ensureCodec(frame.header)
+        var index = decoder.dequeueInputBuffer(INPUT_TIMEOUT_US)
+        while (index < 0) {
+            // Every input buffer is full: let the output side make room.
+            drain(0)
+            index = decoder.dequeueInputBuffer(INPUT_TIMEOUT_US)
+        }
+        val input = decoder.getInputBuffer(index) ?: return
+        input.clear()
+        input.put(frame.bytes)
+        decoder.queueInputBuffer(index, 0, frame.bytes.size, presentationUs, 0)
+        presentationUs += frame.header.samplesPerFrame * 1_000_000L / frame.header.sampleRate
+        drain(0)
+    }
+
+    /** Hands on everything decoded so far. Returns true once the end of the stream has come out. */
+    private fun drain(timeoutUs: Long): Boolean {
+        val decoder = codec ?: return true
+        while (true) {
+            val index = decoder.dequeueOutputBuffer(info, timeoutUs)
+            when {
+                index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED -> readOutputFormat(decoder.outputFormat)
+                index == MediaCodec.INFO_TRY_AGAIN_LATER -> return false
+                index >= 0 -> {
+                    val output = decoder.getOutputBuffer(index)
+                    if (output != null && info.size > 0) {
+                        output.position(info.offset)
+                        output.limit(info.offset + info.size)
+                        emit(output.slice().order(ByteOrder.nativeOrder()))
+                    }
+                    decoder.releaseOutputBuffer(index, false)
+                    if ((info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) return true
+                }
+                // INFO_OUTPUT_BUFFERS_CHANGED and anything else: look again.
+            }
+        }
+    }
+
+    private fun readOutputFormat(format: MediaFormat) {
+        if (format.containsKey(MediaFormat.KEY_SAMPLE_RATE)) outputRate = format.getInteger(MediaFormat.KEY_SAMPLE_RATE)
+        if (format.containsKey(MediaFormat.KEY_CHANNEL_COUNT)) outputChannels = format.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
+        outputFloat = format.containsKey(MediaFormat.KEY_PCM_ENCODING) &&
+            format.getInteger(MediaFormat.KEY_PCM_ENCODING) == AudioFormat.ENCODING_PCM_FLOAT
+    }
+
+    /** One output buffer, folded to mono Float32 and trimmed of encoder delay. */
+    private fun emit(buffer: java.nio.ByteBuffer) {
+        val channels = outputChannels.coerceAtLeast(1)
+        val frames: Int
+        val mono: FloatArray
+        if (outputFloat) {
+            val floats = buffer.asFloatBuffer()
+            frames = floats.remaining() / channels
+            mono = FloatArray(frames)
+            for (i in 0 until frames) {
+                var sum = 0f
+                for (c in 0 until channels) sum += floats.get(i * channels + c)
+                mono[i] = sum / channels
+            }
+        } else {
+            val shorts = buffer.asShortBuffer()
+            frames = shorts.remaining() / channels
+            mono = FloatArray(frames)
+            for (i in 0 until frames) {
+                var sum = 0f
+                for (c in 0 until channels) sum += shorts.get(i * channels + c)
+                mono[i] = sum / channels / 32768f
+            }
+        }
+        if (toTrim >= mono.size) {
+            toTrim -= mono.size
+            return
+        }
+        val start = toTrim
+        toTrim = 0
+        val out = if (start == 0) mono else mono.copyOfRange(start, mono.size)
+        if (out.isNotEmpty()) onPcm(out, outputRate)
+    }
+}
