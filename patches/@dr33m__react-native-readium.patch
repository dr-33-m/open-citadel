+    fun synthesisFailed(requestId: String, message: String) {
+        if (requestId != latestSynthesisRequestId) return
+        val failedNavigator = navigator ?: return
+        val locator = failedNavigator.location.value.utteranceLocator
+        scope.launch {
+            // A missing or failed Kokoro pack should not strand the book.
+            stop()
+            start(rate = currentRate, voice = SYSTEM_VOICE, fromLocator = locator)
+        }
+    }
+
     fun cleanup() {
         stop()
+        systemFactory = null
         factory = null
     }
 }
